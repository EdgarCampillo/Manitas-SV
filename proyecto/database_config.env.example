# ⚠️ IMPORTANTE: Este archivo es solo una PLANTILLA
# Copia este archivo a .env y completa con tus credenciales REALES
# El archivo .env NO se sube al repositorio (está en .gitignore)

# ============================================
# Configuración de Base de Datos PostgreSQL
# ============================================
# Para que todos usen la misma base de datos, comparte estas credenciales
# de forma segura (no las pongas aquí si son reales)

DB_NAME=manitas_db
DB_USER=postgres
DB_PASSWORD=REEMPLAZA_CON_TU_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# ============================================
# Configuración de Google OAuth2
# ============================================
# Obtén estas credenciales desde Google Cloud Console
# https://console.cloud.google.com/

GOOGLE_OAUTH2_KEY=tu_google_oauth2_key_aqui
GOOGLE_OAUTH2_SECRET=tu_google_oauth2_secret_aqui

# ============================================
# Django Secret Key
# ============================================
# Genera una nueva clave secreta para producción
# Puedes usar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=tu_secret_key_aqui

# ============================================
# Configuración de Email (para recuperación de contraseña)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_aqui
DEFAULT_FROM_EMAIL=tu_email@gmail.com

# ============================================
# Credenciales del Administrador
# ============================================
# Estas credenciales se usarán al ejecutar: python manage.py setup_admin
# Si no se especifican, se usarán los valores por defecto: admin/admin123

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@manitas.com
ADMIN_PASSWORD=admin123

